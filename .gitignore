.claude/
.expo/web/
node_modules
android/build/
android/app/build/
android/.gradle/
android/app/.cxx/
ble_log.txt
.env
.env.local
.vscode/
.expo/devices.json

app-log.txt
*.logcat
expo-run-android.log

# Signing credentials - NEVER commit
*.jks
*.pem
*.keystore

# App Store Connect API keys - NEVER commit
*.p8
AuthKey_*.p8

# Build artifacts. Use a contents glob (not bare directory) so the
# Play-verification file below can override via negation; bare
# `dir/` excludes the directory itself and prevents re-inclusion of
# anything inside it.
android/app/src/main/assets/*
!android/app/src/main/assets/adi-registration.properties

# Firebase / FCM (sensitive)
google-services.json
android/app/google-services.json
*-firebase-adminsdk-*.json
firebase-debug.log
.firebase/

# iOS native project — regenerated by 'expo prebuild', do not commit
ios/

# Expo build artifacts
.expo/prebuild/
.expo/xcodebuild.log
.expo/xcodebuild-error.log

# EAS build logs (local redirected output)
eas-build-*.log
